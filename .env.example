# Public URL of the site (used in watermarks, certificates and e-mails)
BASE_URL=https://artguard.example
PORT=3000
NODE_ENV=production
SITE_NAME=ARTGUARD
# Where the database, originals, previews and keys are stored. Back this up!
DATA_DIR=/data
# Set when running behind a reverse proxy (number of hops, or "loopback")
TRUST_PROXY=1
# Outgoing mail (password resets, match alerts). Without it, mail is only logged.
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=ARTGUARD <no-reply@artguard.example>
# Egress proxy for the monitor and timestamping, if the server has no direct internet access
# OUTBOUND_PROXY=http://proxy.internal:3128
# Also receives false-claim reports (in addition to users granted admin with scripts/admin.js)
ADMIN_EMAIL=admin@artguard.example
# Optional: provide the Ed25519 signing key instead of generating one in DATA_DIR/keys
# SIGNING_KEY_PEM="-----BEGIN PRIVATE KEY-----..."
# OTS_CALENDARS=https://a.pool.opentimestamps.org,https://b.pool.opentimestamps.org
# RESCAN_HOURS=24
# DISABLE_SCHEDULER=1

# Reverse image search (finds copies anywhere on the web). Pick one provider:
# GOOGLE_VISION_API_KEY=...        # Google Cloud Vision, Web Detection (1,000 free/month, then about $3.50 per 1,000)
# TINEYE_API_KEY=...               # TinEye API (prepaid search bundles)
# SEARCH_PROVIDER=google           # google | tineye (defaults to whichever key is set)
# SEARCH_INTERVAL_DAYS=7           # how often each opted-in artwork is searched
# SEARCH_MONTHLY_LIMIT=1000        # hard cap on paid searches per month
